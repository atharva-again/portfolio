---
import type { ContentEntry, Heading } from "../lib/content";
import InfoPanelBody from "./InfoPanelBody.astro";

type Props = {
	entry: ContentEntry;
	headings: Heading[];
	variant: "mobile" | "desktop";
};

const { entry, headings, variant } = Astro.props;
---

{
	variant === "mobile" ? (
		<div class="info-panel-mobile">
			<div
				data-info-panel-anchor
				class="info-panel info-panel-anchor"
			>
				<InfoPanelBody entry={entry} headings={headings} />
			</div>
			<div
				data-info-panel-floating
				class="info-panel info-panel-floating"
				aria-hidden="true"
				inert
			>
				<InfoPanelBody entry={entry} headings={headings} />
			</div>
			<button
				type="button"
				data-info-panel-toggle
				aria-label="Show info"
				aria-expanded="false"
				inert
				class="info-panel-toggle"
			>
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>
	) : (
		<div class="info-panel desktop-info-panel">
			<InfoPanelBody entry={entry} headings={headings} />
		</div>
	)
}

<script>
	import "../scripts/info-panel";
</script>

<style>
	.info-panel {
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: #fafafa;
	}

	.info-panel-mobile {
		display: none;
	}

	@media (max-width: 767px) {
		.info-panel-mobile {
			display: block;
		}

		.info-panel-anchor {
			margin-block: 2rem 3.75rem;
		}

		.info-panel-floating {
			position: fixed;
			right: 2rem;
			bottom: 2.5rem;
			left: 2rem;
			z-index: 40;
			padding: 1rem;
			box-shadow: 0 25px 50px rgb(0 0 0 / 25%);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-120%) scale(0.95);
			transition:
				opacity 250ms ease,
				transform 250ms ease;
		}

		.info-panel-floating.is-open {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.info-panel-toggle {
			position: fixed;
			top: 50%;
			right: -0.25rem;
			z-index: 50;
			display: inline-flex;
			width: 2.25rem;
			height: 2.5rem;
			align-items: center;
			justify-content: center;
			transform: translate(3rem, -50%);
			border: 1px solid rgb(255 255 255 / 20%);
			border-radius: 0.75rem 0 0 0.75rem;
			background: rgb(0 0 0 / 60%);
			color: rgb(255 255 255 / 90%);
			backdrop-filter: blur(12px);
			opacity: 0;
			pointer-events: none;
			transition:
				transform 500ms ease,
				opacity 500ms ease;
		}

		.info-panel-toggle svg {
			width: 1.25rem;
			height: 1.25rem;
		}

		.info-panel-toggle.is-visible {
			transform: translate(0, -50%);
			opacity: 1;
			pointer-events: auto;
		}

		.info-panel-toggle.is-open svg {
			transform: rotate(180deg);
		}

		.desktop-info-panel {
			display: none;
		}
	}

	@media (prefers-color-scheme: dark) {
		.info-panel {
			background: rgb(24 24 27 / 50%);
		}

		.info-panel-toggle {
			border-color: rgb(63 63 70 / 50%);
			background: rgb(39 39 42 / 60%);
		}
	}
</style>

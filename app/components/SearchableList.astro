---
import { imageAspectClass } from "../lib/image";
import type { SearchItem } from "../lib/listing";
import ResponsiveImage from "./ResponsiveImage.astro";

type Props = {
	items: SearchItem[];
	placeholder?: string;
	id: string;
};

const { items, placeholder = "Search...", id } = Astro.props;
const tagCounts = new Map<string, number>();
for (const item of items) {
	for (const tag of item.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.keys()].sort((a, b) =>
	a.localeCompare(b, undefined, { sensitivity: "base" }),
);
---

<section data-searchable-list data-list-id={id} class="searchable-list">
	<div class="search-controls">
		<label for={`search-${id}`} class="visually-hidden">Search</label>
		<div class="search-input-wrap">
			<input
				id={`search-${id}`}
				data-search-input
				type="search"
				placeholder={placeholder}
				class="search-input"
				aria-label="Search"
			/>
			<button
				type="button"
				data-clear-search
				aria-label="Clear search"
				title="Clear"
				class="search-clear"
			>✕</button>
		</div>
	</div>

	{tags.length > 0 && (
		<div class="search-tags" data-search-tags>
			<button
				type="button"
				data-filter-tag="all"
				class="filter-tag"
				aria-pressed="true"
			>All</button>
			{tags.map((tag) => (
				<button
					type="button"
					data-filter-tag={tag}
					class="filter-tag"
					aria-pressed="false"
					title={`Filter by ${tag} (${tagCounts.get(tag) ?? 0})`}
				>
					<span>{tag}</span>
					<span class="filter-count">({tagCounts.get(tag) ?? 0})</span>
				</button>
			))}
		</div>
	)}

	<div class="search-results" data-search-results>
		{
			items.map((item) => (
				<article
					data-search-item
					data-item-id={item.id}
					data-title={item.title}
					data-description={item.description}
					data-tags={item.tags.join("|")}
					data-date={item.date ?? ""}
					class="search-item"
				>
					<div class="search-item-layout">
						{item.image && (
							<a href={item.href} class="search-item-image-link" tabindex="-1" aria-hidden="true">
								<div class:list={["search-item-image", imageAspectClass(item.imageAspect)]}>
									<ResponsiveImage
										src={item.image}
										alt={item.title}
										fill
										loadingIndicator
										sizes="(min-width: 768px) 10rem, 100vw"
										class="image-contain"
									/>
								</div>
							</a>
						)}
						<div class="search-item-copy">
							<a href={item.href} class="search-item-link">
								<div class="search-item-heading">
									<div>
										<h3 data-search-title class="search-item-title">
											{item.title}
										</h3>
										{item.description && (
											<p data-search-description class="search-item-description">
												{item.description}
											</p>
										)}
									</div>
									{item.date && (
										<time class="search-item-date">
											{item.date}
										</time>
									)}
								</div>
							</a>
							{item.tags.length > 0 && (
								<div class="item-tags">
									{item.tags.map((tag) => (
										<button
											type="button"
											data-tag-shortcut={tag}
											class="search-shortcut"
											title={`Filter by ${tag}`}
										>
											{tag}
										</button>
									))}
								</div>
							)}
						</div>
					</div>
				</article>
			))
		}
		<p data-empty-results class="empty-results">No results.</p>
	</div>
</section>

<script>
	import "../scripts/search";
</script>

<style>
	.searchable-list {
		width: 100%;
	}

	.search-controls {
		display: flex;
		margin-bottom: 1.5rem;
		gap: 0.75rem;
	}

	.search-input-wrap {
		position: relative;
		width: 100%;
	}

	.search-input {
		width: 100%;
		padding: 0.5rem 2.5rem 0.5rem 1rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		outline: none;
		background: #fff;
		color: #18181b;
	}

	.search-input:focus {
		box-shadow: 0 0 0 2px var(--border);
	}

	.search-clear {
		position: absolute;
		top: 50%;
		right: 0.5rem;
		display: inline-flex;
		width: 1.5rem;
		height: 1.5rem;
		transform: translateY(-50%);
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: 0.25rem;
		background: transparent;
		color: #71717a;
		cursor: pointer;
	}

	.search-clear:hover {
		color: #3f3f46;
	}

	.search-tags,
	.item-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.search-tags {
		margin-bottom: 1.5rem;
	}

	.filter-tag,
	.search-shortcut {
		display: inline-flex;
		padding: 0.25rem 0.5rem;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--background);
		color: var(--muted);
		cursor: pointer;
		font-size: 0.875rem;
		line-height: 1.428571;
		transition:
			background-color 140ms ease,
			color 140ms ease;
	}

	.filter-tag:hover,
	.search-shortcut:hover {
		background: #fafafa;
		color: #18181b;
	}

	.filter-tag[aria-pressed="true"] {
		background: var(--surface-hover);
		color: var(--foreground);
	}

	.filter-tag:not([data-filter-tag="all"])[aria-pressed="true"] {
		border-color: #d4d4d8;
	}

	.filter-count {
		color: var(--subtle);
		font-size: 0.75rem;
		line-height: 1.333333;
	}

	.search-results {
		display: grid;
		gap: 2rem;
	}

	.search-item-layout {
		display: flex;
		gap: 1rem;
	}

	.search-item-image-link {
		display: block;
		width: 10rem;
		flex: none;
	}

	.search-item-link {
		display: block;
	}

	.search-item {
		min-width: 0;
	}

	.search-item-image {
		position: relative;
		overflow: hidden;
		border-radius: 0.5rem;
	}

	.search-item-copy {
		min-width: 0;
		flex: 1;
	}

	.search-item-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.search-item-title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.555556;
		transition: color 160ms ease;
	}

	.search-item-link:hover .search-item-title {
		color: var(--hover-muted);
	}

	.search-item-description {
		margin: 0.5rem 0 0;
		color: var(--muted);
		line-height: 1.5;
	}

	.search-item-date {
		flex: none;
		margin-top: 0.2rem;
		color: var(--subtle);
		font-size: 0.875rem;
		line-height: 1.428571;
		white-space: nowrap;
	}

	.item-tags {
		margin-top: 0.75rem;
	}

	.search-shortcut {
		border-radius: 999px;
		font-size: 0.75rem;
		line-height: 1.333333;
	}

	.empty-results {
		display: none;
		color: var(--muted);
	}

	@media (max-width: 767px) {
		.search-item-layout {
			flex-direction: column;
		}

		.search-item-image-link {
			width: 100%;
		}

		.search-item-image {
			width: 100%;
		}

		.search-item-heading {
			flex-direction: column;
			gap: 0.35rem;
		}

		.search-item-date {
			margin: 0;
		}
	}

	@media (prefers-color-scheme: dark) {
		.search-input {
			background: #000;
			color: #f4f4f5;
		}

		.search-clear {
			color: #a1a1aa;
		}

		.search-clear:hover {
			color: #e4e4e7;
		}

		.filter-tag:hover,
		.search-shortcut:hover {
			background: #18181b;
			color: #e4e4e7;
		}

		.filter-tag[aria-pressed="true"] {
			background: #18181b;
			border-color: #3f3f46;
			color: #f4f4f5;
		}

		.filter-tag:not([data-filter-tag="all"])[aria-pressed="true"] {
			background: #27272a;
			border-color: #52525b;
		}

		.search-shortcut {
			background: #000;
		}
	}
</style>

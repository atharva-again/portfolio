---
import { ATHARVA_ASCII_ART } from "../lib/ascii";
import { CONTACT } from "../lib/contact";
import Socials from "./Socials.astro";
import VisitorCount from "./VisitorCount.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-grid">
		<div>
			<a href="/" class="footer-brand">AV</a>
			<p class="footer-description">
				I'm Atharva. I love building, learning, investing, designing, writing,
				reading, thrift-ing, traveling, rails, food, fashion, music, and probably
				a lot more.
			</p>
		</div>
		<div>
			<h4 class="footer-heading">Explore</h4>
			<ul class="footer-list">
				<li><a href="/" class="footer-link">Home</a></li>
				<li><a href="/projects" class="footer-link">Projects</a></li>
				<li><a href="/blogs" class="footer-link">Blog</a></li>
			</ul>
		</div>
		<div>
			<h4 class="footer-heading">Connect</h4>
			<Socials links={CONTACT} forceEmailPlacement />
			<div class="footer-details">
				<VisitorCount />
				<div>© {year} Atharva Verma</div>
			</div>
		</div>
	</div>
	<div class="footer-ascii">
		<pre
			aria-hidden="true"
		>{ATHARVA_ASCII_ART}</pre>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: transparent;
	}

	.footer-grid {
		display: grid;
		width: 100%;
		max-width: 56rem;
		margin: auto;
		padding: 3rem 1.5rem;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.footer-brand {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.555556;
	}

	.footer-description {
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.428571;
	}

	.footer-heading {
		margin: 0 0 0.75rem;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.428571;
	}

	.footer-list {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
		line-height: 1.428571;
	}

	.footer-list li + li {
		margin-top: 0.5rem;
	}

	.footer-link,
	.footer-details {
		color: var(--muted);
		transition: color 160ms ease;
	}

	.footer-link:hover {
		color: var(--hover-solid);
	}

	.footer-details {
		display: grid;
		margin-top: 1.5rem;
		gap: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.428571;
	}

	.footer-ascii {
		display: flex;
		justify-content: center;
		overflow: hidden;
		padding: 0 1.5rem 2rem;
	}

	.footer-ascii pre {
		margin: 0;
		color: var(--foreground);
		font-family: "Geist Mono", monospace;
		font-size: 0.4rem;
		line-height: 1;
		opacity: 0.4;
		white-space: pre;
		user-select: none;
	}

	@media (min-width: 640px) {
		.footer-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.footer-ascii pre {
			font-size: 0.6rem;
		}
	}

	@media (min-width: 768px) {
		.footer-ascii pre {
			font-size: 0.875rem;
		}
	}

	@media (min-width: 1024px) {
		.footer-ascii pre {
			font-size: 1rem;
		}
	}
</style>

---
import type { ContentEntry, Heading } from "../lib/content";
import { imageAspectClass } from "../lib/image";
import ImageLightbox from "./ImageLightbox.astro";
import InfoPanel from "./InfoPanel.astro";
import ResponsiveImage from "./ResponsiveImage.astro";

type Props = {
	entry: ContentEntry;
	headings: Heading[];
};

const { entry, headings } = Astro.props;
const isProject = entry.collection === "projects";
const title = entry.data.title;
const backHref = isProject ? "/projects" : "/blogs";
const backLabel = isProject ? "Back to projects" : "Back to blogs";
---

<main class="page-main">
	<div class="detail-container">
		<header class="detail-header">
			<a
				href={backHref}
				class="back-link"
			>← {backLabel}</a>
			<h1 class="detail-title">
				{title}
			</h1>
		</header>

		<div class="detail-grid">
			<div class="detail-main">
				<div
					class:list={[
						"detail-hero",
						imageAspectClass(entry.data.heroImageAspect),
					]}
				>
					<button
						type="button"
						data-lightbox-trigger
						aria-label={`Enlarge ${title} image`}
						class="detail-hero-button"
					>
						<ResponsiveImage
							src={entry.data.heroImage}
							alt={title}
							fill
							priority
							loadingIndicator
							maxWidth={1920}
							sizes="(min-width: 1200px) 720px, (min-width: 768px) 60vw, 100vw"
							class="image-cover"
						/>
						<span
							data-image-tooltip
							aria-hidden="true"
							class="image-cursor-tooltip"
						>Click to enlarge</span>
					</button>
				</div>
				<InfoPanel
					entry={entry}
					headings={headings}
					variant="mobile"
				/>
				<div class="mdx-content">
					<slot />
				</div>
			</div>
			<aside class="detail-sidebar">
				<InfoPanel
					entry={entry}
					headings={headings}
					variant="desktop"
				/>
			</aside>
		</div>
	</div>
</main>
<ImageLightbox />

<!-- MDX is slotted content, so its typography is intentionally scoped by .mdx-content. -->
<style is:global>
	.detail-container {
		width: 100%;
		max-width: 72rem;
		margin: auto;
		padding: 6rem 1.5rem;
	}

	.detail-header {
		margin-bottom: 3rem;
	}

	.back-link {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.428571;
		transition: color 160ms ease;
	}

	.back-link:hover {
		color: var(--hover-solid);
	}

	.detail-title {
		margin: 1.5rem 0 0;
		color: #18181b;
		font-size: 2.25rem;
		line-height: 1.111111;
		letter-spacing: -0.025em;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 3rem;
	}

	.detail-main {
		min-width: 0;
		grid-column: span 2;
	}

	.detail-sidebar {
		position: sticky;
		top: 6rem;
		align-self: start;
		grid-column: span 1;
	}

	.detail-hero {
		position: relative;
		margin-bottom: 3rem;
		overflow: hidden;
		border-radius: 0.5rem;
	}

	.detail-hero-button {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.detail-hero-button img {
		transition: opacity 150ms ease;
	}

	.detail-hero-button:hover img {
		opacity: 0.9;
	}

	.mdx-content {
		color: #27272a;
		font-size: 1.125rem;
		line-height: 1.75;
	}

	.mdx-content :is(h1, h2, h3, h4, h5, h6) {
		margin-top: 2.5rem;
		color: #18181b;
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.25;
		overflow-wrap: anywhere;
		scroll-margin-top: 6.25rem;
	}

	.mdx-content h1 {
		margin-top: 0;
		font-size: 2.25rem;
	}

	.mdx-content h2 {
		font-size: 1.875rem;
	}

	.mdx-content h3 {
		font-size: 1.5rem;
	}

	.mdx-content h4 {
		font-size: 1.25rem;
	}

	.mdx-content p,
	.mdx-content ul,
	.mdx-content ol,
	.mdx-content blockquote,
	.mdx-content pre {
		margin-top: 1.5rem;
	}

	.mdx-content ul,
	.mdx-content ol {
		padding-left: 1.5rem;
	}

	.mdx-content ul {
		list-style: disc;
	}

	.mdx-content ol {
		list-style: decimal;
	}

	.mdx-content li {
		margin-block: 0.4rem;
	}

	.mdx-content a {
		color: var(--foreground);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.mdx-content blockquote {
		padding-left: 1.5rem;
		border-left: 4px solid var(--border);
		color: var(--muted);
		font-style: italic;
	}

	.mdx-content pre {
		overflow-x: auto;
		padding: 1rem;
		border-radius: 0.5rem;
		background: #18181b;
		color: #f4f4f5;
		font-family: "Geist Mono", monospace;
		font-size: 0.875rem;
		line-height: 1.75;
	}

	.mdx-content :not(pre) > code {
		padding: 0.15rem 0.4rem;
		border-radius: 0.25rem;
		background: var(--surface-hover);
		font-family: "Geist Mono", monospace;
		font-size: 0.875em;
	}

	.mdx-content hr {
		height: 1px;
		margin-block: 3rem;
		border: 0;
		background: var(--border);
	}

	@media (max-width: 767px) {
		.detail-grid {
			display: block;
		}

		.detail-sidebar {
			display: none;
		}
	}

	@media (min-width: 768px) {
		.detail-title {
			font-size: 3rem;
			line-height: 1;
		}
	}

	@media (prefers-color-scheme: dark) {
		.detail-title,
		.mdx-content :is(h1, h2, h3, h4, h5, h6) {
			color: #f4f4f5;
		}

		.mdx-content {
			color: #e4e4e7;
		}
	}
</style>

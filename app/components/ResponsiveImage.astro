---
import { getImage } from "astro:assets";
import { imageSource, type ImageSource } from "../lib/image";

type Props = {
	src: ImageSource;
	alt: string;
	class?: string;
	fill?: boolean;
	priority?: boolean;
	loadingIndicator?: boolean;
	sizes?: string;
	maxWidth?: number;
	width?: number;
	height?: number;
};

const {
	src,
	alt,
	class: className,
	fill = false,
	priority = false,
	loadingIndicator = false,
	sizes,
	maxWidth = 960,
	width,
	height,
} = Astro.props;
const asset = typeof src === "string" ? undefined : src;
const optimizedWidths = asset
	? [
			...[320, 640, 960, 1280, 1920].filter(
				(candidate) => candidate < Math.min(asset.width, maxWidth),
			),
			Math.min(asset.width, maxWidth),
		]
	: [];
const optimized = asset
	? await getImage({
			src: asset,
			widths: optimizedWidths,
			format: "webp",
			quality: 85,
		})
	: undefined;
---

{loadingIndicator && (
	<span
		data-image-loading-skeleton
		aria-hidden="true"
		class="image-loading-skeleton"
	></span>
)}
<img
	src={optimized?.src ?? imageSource(src)}
	srcset={optimized?.srcSet.attribute}
	sizes={sizes ?? (asset ? "100vw" : undefined)}
	alt={alt}
	width={width ?? asset?.width}
	height={height ?? asset?.height}
	loading={priority ? "eager" : "lazy"}
	fetchpriority={priority ? "high" : "auto"}
	data-image-skeleton-image={loadingIndicator ? "true" : undefined}
	class={className}
	style={fill ? "position:absolute;inset:0;width:100%;height:100%;" : undefined}
/>

<script>
	import "../scripts/image-skeletons";
</script>

<!-- Shared image utilities also style the image containers and tooltips in callers. -->
<style is:global>
	.image-aspect-landscape {
		aspect-ratio: 3 / 2;
	}

	.image-aspect-video {
		aspect-ratio: 16 / 9;
	}

	.image-cover,
	.image-contain {
		width: 100%;
		height: 100%;
	}

	.image-cover {
		object-fit: cover;
	}

	.image-contain {
		object-fit: contain;
	}

	.image-loading-skeleton {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: 0.5rem;
		background: #e4e4e7;
		animation: image-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	.image-loading-skeleton[hidden] {
		display: none;
	}

	@keyframes image-pulse {
		50% {
			opacity: 0.5;
		}
	}

	.image-cursor-tooltip {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 3;
		display: none;
		padding: 0.25rem 0.5rem;
		transform: translate(-50%, -120%);
		border-radius: 999px;
		background: rgb(0 0 0 / 70%);
		color: white;
		font-size: 0.75rem;
		line-height: 1.428571;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 150ms ease;
	}

	.image-cursor-tooltip.is-visible {
		opacity: 1;
	}

	@media (min-width: 640px) {
		.image-cursor-tooltip {
			display: block;
		}
	}

	@media (prefers-color-scheme: dark) {
		.image-loading-skeleton {
			background: #27272a;
		}
	}
</style>

---
import type { ContentEntry, Heading } from "../lib/content";

type Props = {
	entry: ContentEntry;
	headings: Heading[];
};

const { entry, headings } = Astro.props;
const { tags, links = [] } = entry.data;
const isProject = entry.collection === "projects";
const year = isProject ? entry.data.year : entry.data.date;
const listingPath = isProject ? "/projects" : "/blogs";
---

<div class="info-section">
	<div class="info-metadata">
		{year && (
			<div>
				<h3 class="info-section-title">Year</h3>
				<p class="info-value">{year}</p>
			</div>
		)}
		{isProject && (
			<div>
				<h3 class="info-section-title">Status</h3>
				<p class="info-value info-status">{entry.data.status}</p>
			</div>
		)}
	</div>
</div>

{tags.length > 0 && (
	<div class="info-section">
		<h3 class="info-section-title">{isProject ? "Tech Stack" : "Tags"}</h3>
		<div class="info-tags">
			{tags.map((tag) => (
				<a
					href={`${listingPath}?tags=${encodeURIComponent(tag)}`}
					class="info-tag"
				>
					{tag}
				</a>
			))}
		</div>
	</div>
)}

{links.length > 0 && (
	<div class="info-section">
		<h3 class="info-section-title">Links</h3>
		<div class="info-links">
			{links.map((link) => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="info-link"
					aria-label={link.type}
					title={link.type}
				>
					{link.type === "repo" ? (
						<svg class="info-link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
						</svg>
					) : link.type === "demo" ? (
						<svg class="info-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M14 3h7v7"></path>
							<path d="M10 14 21 3"></path>
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						</svg>
					) : link.type === "medium" ? (
						<svg class="info-link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M4.21 0A4.201 4.201 0 0 0 0 4.21v15.58A4.201 4.201 0 0 0 4.21 24h15.58A4.201 4.201 0 0 0 24 19.79v-1.093c-.137.013-.278.02-.422.02-2.577 0-4.027-2.146-4.09-4.832a7.592 7.592 0 0 1 .022-.708c.093-1.186.475-2.241 1.105-3.022a3.885 3.885 0 0 1 1.395-1.1c.468-.237 1.127-.367 1.664-.367h.023c.101 0 .202.004.303.01V4.211A4.201 4.201 0 0 0 19.79 0Zm.198 5.583h4.165l3.588 8.435 3.59-8.435h3.864v.146l-.019.004c-.705.16-1.063.397-1.063 1.254h-.003l.003 10.274c.06.676.424.885 1.063 1.03l.02.004v.145h-4.923v-.145l.019-.005c.639-.144.994-.353 1.054-1.03V7.267l-4.745 11.15h-.261L6.15 7.569v9.445c0 .857.358 1.094 1.063 1.253l.02.004v.147H4.405v-.147l.019-.004c.705-.16 1.065-.397 1.065-1.253V6.987c0-.857-.358-1.094-1.064-1.254l-.018-.004zm19.25 3.668c-1.086.023-1.733 1.323-1.813 3.124H24V9.298a1.378 1.378 0 0 0-.342-.047Zm-1.862 3.632c-.1 1.756.86 3.239 2.204 3.634v-3.634z"></path>
						</svg>
					) : link.type === "huggingface" ? (
						<svg class="info-link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12.025 1.13c-5.77 0-10.449 4.647-10.449 10.378 0 1.112.178 2.181.503 3.185.064-.222.203-.444.416-.577a.96.96 0 0 1 .524-.15c.293 0 .584.124.84.284.278.173.48.408.71.694.226.282.458.611.684.951v-.014c.017-.324.106-.622.264-.874s.403-.487.762-.543c.3-.047.596.06.787.203s.31.313.4.467c.15.257.212.468.233.542.01.026.653 1.552 1.657 2.54.616.605 1.01 1.223 1.082 1.912.055.537-.096 1.059-.38 1.572.637.121 1.294.187 1.967.187.657 0 1.298-.063 1.921-.178-.287-.517-.44-1.041-.384-1.581.07-.69.465-1.307 1.081-1.913 1.004-.987 1.647-2.513 1.657-2.539.021-.074.083-.285.233-.542.09-.154.208-.323.4-.467a1.08 1.08 0 0 1 .787-.203c.359.056.604.29.762.543s.247.55.265.874v.015c.225-.34.457-.67.683-.952.23-.286.432-.52.71-.694.257-.16.547-.284.84-.285a.97.97 0 0 1 .524.151c.228.143.373.388.43.625l.006.04a10.3 10.3 0 0 0 .534-3.273c0-5.731-4.678-10.378-10.449-10.378M8.327 6.583a1.5 1.5 0 0 1 .713.174 1.487 1.487 0 0 1 .617 2.013c-.183.343-.762-.214-1.102-.094-.38.134-.532.914-.917.71a1.487 1.487 0 0 1 .69-2.803m7.486 0a1.487 1.487 0 0 1 .689 2.803c-.385.204-.536-.576-.916-.71-.34-.12-.92.437-1.103.094a1.487 1.487 0 0 1 .617-2.013 1.5 1.5 0 0 1 .713-.174m-10.68 1.55a.96.96 0 1 1 0 1.921.96.96 0 0 1 0-1.92m13.838 0a.96.96 0 1 1 0 1.92.96.96 0 0 1 0-1.92M8.489 11.458c.588.01 1.965 1.157 3.572 1.164 1.607-.007 2.984-1.155 3.572-1.164.196-.003.305.12.305.454 0 .886-.424 2.328-1.563 3.202-.22-.756-1.396-1.366-1.63-1.32q-.011.001-.02.006l-.044.026-.01.008-.03.024q-.018.017-.035.036l-.032.04a1 1 0 0 0-.058.09l-.014.025q-.049.088-.11.19a1 1 0 0 1-.083.116 1.2 1.2 0 0 1-.173.18q-.035.029-.075.058a1.3 1.3 0 0 1-.251-.243 1 1 0 0 1-.076-.107c-.124-.193-.177-.363-.337-.444-.034-.016-.104-.008-.2.022q-.094.03-.216.087-.06.028-.125.063l-.13.074q-.067.04-.136.086a3 3 0 0 0-.135.096 3 3 0 0 0-.26.219 2 2 0 0 0-.12.121 2 2 0 0 0-.106.128l-.002.002a2 2 0 0 0-.09.132l-.001.001a1.2 1.2 0 0 0-.105.212q-.013.036-.024.073c-1.139-.875-1.563-2.317-1.563-3.203 0-.334.109-.457.305-.454m.836 10.354c.824-1.19.766-2.082-.365-3.194-1.13-1.112-1.789-2.738-1.789-2.738s-.246-.945-.806-.858-.97 1.499.202 2.362c1.173.864-.233 1.45-.685.64-.45-.812-1.683-2.896-2.322-3.295s-1.089-.175-.938.647 2.822 2.813 2.562 3.244-1.176-.506-1.176-.506-2.866-2.567-3.49-1.898.473 1.23 2.037 2.16c1.564.932 1.686 1.178 1.464 1.53s-3.675-2.511-4-1.297c-.323 1.214 3.524 1.567 3.287 2.405-.238.839-2.71-1.587-3.216-.642-.506.946 3.49 2.056 3.522 2.064 1.29.33 4.568 1.028 5.713-.624m5.349 0c-.824-1.19-.766-2.082.365-3.194 1.13-1.112 1.789-2.738 1.789-2.738s.246-.945.806-.858.97 1.499-.202 2.362c-1.173.864-.233 1.45.685.64.45-.812 1.683-2.896 2.322-3.295s1.089-.175.938.647-2.822 2.813-2.562 3.244-1.176-.506-1.176-.506-2.866-2.567-3.49-1.898.473 1.23 2.037 2.16c1.564.932 1.686 1.178 1.464 1.53s3.675-2.511 4-1.297c.323 1.214-3.524 1.567-3.287 2.405.238.839 2.71-1.587 3.216-.642.506.946-3.49 2.056-3.522 2.064-1.29.33-4.568 1.028-5.713-.624"></path>
						</svg>
					) : link.type === "pypi" ? (
						<svg class="info-link-icon" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
							<path d="M439.8 200.5c-7.7-30.9-22.3-54.2-53.4-54.2h-40.1v47.4c0 36.8-31.2 67.8-66.8 67.8H172.7c-29.2 0-53.4 25-53.4 54.3v101.8c0 29 25.2 46 53.4 54.3 33.8 9.9 66.3 11.7 106.8 0 26.9-7.8 53.4-23.5 53.4-54.3v-40.7H226.2v-13.6h160.2c31.1 0 42.6-21.7 53.4-54.2 11.2-33.5 10.7-65.7 0-108.6zM286.2 404c11.1 0 20.1 9.1 20.1 20.3 0 11.3-9 20.4-20.1 20.4-11 0-20.1-9.2-20.1-20.4.1-11.3 9.1-20.3 20.1-20.3zM167.8 248.1h106.8c29.7 0 53.4-24.5 53.4-54.3V91.9c0-29-24.4-50.7-53.4-55.6-35.8-5.9-74.7-5.6-106.8.1-45.2 8-53.4 24.7-53.4 55.6v40.7h106.9v13.6h-147c-31.1 0-58.3 18.7-66.8 54.2-9.8 40.7-10.2 66.1 0 108.6 7.6 31.6 25.7 54.2 56.8 54.2H101v-48.8c0-35.3 30.5-66.4 66.8-66.4zm-6.7-142.6c-11.1 0-20.1-9.1-20.1-20.3.1-11.3 9-20.4 20.1-20.4 11 0 20.1 9.2 20.1 20.4s-9 20.3-20.1 20.3z"></path>
						</svg>
					) : (
						<svg class="info-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<path d="M14 2v6h6"></path>
							<path d="M8 13h8"></path>
							<path d="M8 17h8"></path>
							<path d="M8 9h2"></path>
						</svg>
					)}
				</a>
			))}
		</div>
	</div>
)}

{headings.length > 0 && (
	<div class="toc" data-table-of-contents>
		<h3 class="toc-title">Contents</h3>
		<nav class="toc-nav">
			<div class="toc-line"></div>
			<ul class="toc-list">
				{headings.map((heading) => (
					<li
						class="toc-item"
						style={`padding-left:${(heading.level - 2) * 12 + 16}px`}
					>
						<span data-toc-active-marker={heading.id} class="toc-active-marker"></span>
						<a
							href={`#${encodeURIComponent(heading.id)}`}
							data-toc-link={heading.id}
							class="toc-link"
						>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
)}

<style>
	.info-section {
		margin-bottom: 1.5rem;
	}

	.info-section:last-child {
		margin-bottom: 0;
	}

	.info-section-title,
	.toc-title {
		margin: 0 0 0.5rem;
		color: #71717a;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		line-height: 1.428571;
	}

	.info-metadata {
		display: flex;
		gap: 2rem;
	}

	.info-value {
		margin: 0;
		color: #18181b;
		font-size: 1rem;
	}

	.info-status {
		text-transform: capitalize;
	}

	.info-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.info-tag {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		background: #e4e4e7;
		color: #27272a;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.428571;
		transition:
			background-color 150ms ease,
			color 150ms ease;
	}

	.info-tag:hover {
		background: #d4d4d8;
	}

	.info-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.info-link {
		display: inline-flex;
		align-items: center;
		color: var(--foreground);
		transition: color 140ms ease;
	}

	.info-link:hover {
		color: var(--hover-solid);
	}

	.info-link-icon {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
	}

	.toc {
		margin-top: 2rem;
	}

	.toc-nav {
		position: relative;
	}

	.toc-line,
	.toc-active-marker {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 2px;
	}

	.toc-line {
		background: var(--border);
	}

	.toc-active-marker {
		display: none;
		background: var(--accent);
	}

	.toc-active-marker.is-active {
		display: block;
	}

	.toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc-item {
		position: relative;
	}

	.toc-link {
		display: block;
		padding: 0.25rem 0.25rem 0.25rem 1rem;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.428571;
		overflow-wrap: anywhere;
		transition: color 140ms ease;
	}

	.toc-link:hover,
	.toc-link.is-active {
		color: var(--foreground);
	}

	@media (prefers-color-scheme: dark) {
		.info-value {
			color: #f4f4f5;
		}

		.info-section-title,
		.toc-title {
			color: #a1a1aa;
		}

		.info-tag {
			background: #27272a;
			color: #e4e4e7;
		}

		.info-tag:hover {
			background: #3f3f46;
			color: #f4f4f5;
		}
	}
</style>
